{
  "name": "userhub-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon --no-warnings index.js",
    "start": "node --no-warnings index.js",
    "test": "node --no-warnings --test tests/unit/**/*.test.js tests/integration/**/*.test.js tests/functional/**/*.test.js tests/smoke/**/*.test.js tests/system/**/*.test.js",
    "test:unit": "node --no-warnings --test tests/unit/**/*.test.js",
    "test:integration": "node --no-warnings --test tests/integration/**/*.test.js",
    "test:functional": "node --no-warnings --test tests/functional/**/*.test.js",
    "test:smoke": "node --no-warnings --test tests/smoke/**/*.test.js",
    "test:system": "node --no-warnings --test tests/system/**/*.test.js",
    "test:coverage": "c8 node --no-warnings --test tests/unit/**/*.test.js tests/integration/**/*.test.js tests/functional/**/*.test.js tests/smoke/**/*.test.js tests/system/**/*.test.js",
    "perf": "node scripts/perf.js",
    "smoke:deployed": "node scripts/smoke-deployed.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "autocannon": "^8.0.0",
    "c8": "^12.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.9.5",
    "supertest": "^7.2.2"
  }
}
